# airgate-studio 配置样例
# 复制为本目录（backend/）下的 config.yaml 后按需修改；开发 go run . 与生产二进制
# 都从工作目录读 config.yaml，也可用 CONFIG_PATH 指定其他路径。
# 环境变量可覆盖任意一项（同名大写，如 DATABASE_URL）；config.yaml 缺省时回退纯环境变量。
# ⚠️ config.yaml 含 OAuth secret 与会话密钥，已加入 .gitignore，切勿提交。

# HTTP 监听地址（默认 :8181）
listen_addr: ":8181"

# Postgres 连接串（必填；studio 独立库，表 studio_* 启动时自动建）
database_url: "postgres://dev:dev@localhost:5432/studio?sslmode=disable"

# core 部署地址（必填；服务端调用：OAuth token/userinfo/provision-key、/v1 图像生成）
airgate_base_url: "http://localhost:9517"

# 浏览器可达的 core 地址（可选，缺省同 airgate_base_url；OAuth 授权跳转用。
# 浏览器与服务不在同一台机器（如 WSL/远程部署）或 core 前后端分离 dev 时必须单独指定）
airgate_public_url: "http://172.17.196.241:3000"

# core 管理后台「OAuth 应用」中创建后填入；
# core 侧登记的 redirect_uri 必须精确等于 {public_base_url}/auth/callback
oauth_client_id: "ac_xxx"
oauth_client_secret: "acs_xxx"

# 本应用对外地址（必填，拼 redirect_uri；须与浏览器实际访问地址一致）
public_base_url: "http://172.17.196.241:5174"

# 会话 cookie 的 HMAC 签名密钥（必填；生产用足够长的随机串）
session_secret: "change-me"

# studio 管理员的 core 用户 ID 列表（可选；管理控制台：分组开关、模型上架）
admin_airgate_user_ids: [1]

# 本地数据目录（可选，默认 data；生成图片落 {data_dir}/assets）
data_dir: "data"
