# airgate-studio 环境变量样例
# 推荐优先使用 backend/config.yaml（见 backend/config.yaml.example）；环境变量可覆盖其中任意单项，
# 适合容器/CI 场景。说明详见 README.md / CLAUDE.md；必填项缺失时进程启动即失败。

# ── 服务本体 ──
# HTTP 监听地址（可选，默认 :8181）
LISTEN_ADDR=:8181
# Postgres DSN（必填；表 studio_* 由启动时自动 migrate）
DATABASE_URL=postgres://dev:dev@localhost:5432/studio?sslmode=disable
# 本地数据目录（可选，默认 data；生成图片落 {DATA_DIR}/assets）
DATA_DIR=data

# ── core 接入 ──
# core 部署地址（必填；服务端调用：OAuth token/userinfo/provision-key、/v1 图像生成）
AIRGATE_BASE_URL=http://localhost:9517
# 浏览器可达的 core 地址（可选，缺省同 AIRGATE_BASE_URL；OAuth 授权跳转用。
# core 本地 make dev 时前端在 :3000，与后端 :9517 不同，须单独指定）
AIRGATE_PUBLIC_URL=http://localhost:3000

# ── OAuth 应用凭据（在 core 管理后台「OAuth 应用」中创建后填入）──
# 注意：core 侧登记的 redirect_uri 必须精确等于 {PUBLIC_BASE_URL}/auth/callback
OAUTH_CLIENT_ID=ac_xxx
OAUTH_CLIENT_SECRET=acs_xxx

# ── 会话 ──
# 本应用对外地址（必填，拼 redirect_uri；本地 vite dev 场景填 :5174）
PUBLIC_BASE_URL=http://localhost:5174
# 会话 cookie 的 HMAC 签名密钥（必填；生产用足够长的随机串）
SESSION_SECRET=dev-secret
